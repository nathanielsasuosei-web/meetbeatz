# ---------------------------------------------------------------------------
# Meetbeatz environment variables
# Copy to .env for local development:  cp .env.example .env
# On Vercel: paste these into Settings → Environment Variables instead.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local Docker (matches docker-compose.yml): postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Production (Railway / Neon / Supabase): paste the pooled connection string here.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Enables live Paystack payments. Without it the app runs in test mode
# with a simulated MoMo prompt.
PAYSTACK_SECRET_KEY=
# Set to "simulation" to force the test checkout even if a Paystack key is set.
# Leave empty in production.
PAYMENT_MODE=

# Public URL used in emails and the Paystack callback.
# Leave empty to auto-detect from the incoming request (recommended for previews).
# In production set it, e.g. https://meetbeatz.com
NEXT_PUBLIC_APP_URL=

# Secret for admin session cookies. Use a long random string in production.
SESSION_SECRET=change-me-to-a-random-32-character-string

# Initial admin account — used only when the database is first seeded.
# Required before the first production start.
ADMIN_EMAIL=admin@meetbeatz.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Email delivery — configure ONE of these:
# 1) SMTP (Gmail example: host smtp.gmail.com, port 587, user your Gmail,
#    pass a Gmail App Password, secure false)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# 2) Resend
RESEND_API_KEY=
EMAIL_FROM="Meetbeatz <no-reply@meetbeatz.com>"
