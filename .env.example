# Copy to .env and fill in. Never commit the real .env.
#   macOS/Linux:  cp .env.example .env
#   PowerShell:   Copy-Item .env.example .env

# --- Database -------------------------------------------------------------
# Option A — PostgreSQL installed on this machine (default local port 5432):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
#
# Option B — the PostgreSQL container from docker-compose.yml (host port 5433):
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/app_db
#
# The database itself is not created for you. Create it once with:
#   npm run db:create

# --- Payments -------------------------------------------------------------
# Leave PAYSTACK_SECRET_KEY empty to run in simulation mode (no live charges).
PAYSTACK_SECRET_KEY=
PAYMENT_MODE=simulation

# --- App URL --------------------------------------------------------------
# Used in outbound emails and the Paystack redirect. Leave empty to auto-detect
# from the incoming request (handy for previews on a tunneled/remote host).
NEXT_PUBLIC_APP_URL=

# --- Auth -----------------------------------------------------------------
# Required. Generate one with:  openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-32-character-secret
# Seed credentials for the first admin account (first run only).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# --- Email ----------------------------------------------------------------
# Pick ONE provider. With neither set, order/booking emails are skipped.
EMAIL_FROM="Meetbeatz <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
RESEND_API_KEY=
# Gmail needs an App Password (not your account password), and it is a secret:
# keep it in .env only, never in a committed file.
GMAIL_USER=
GMAIL_APP_PASSWORD=
