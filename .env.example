# Copy this file to .env  (Windows PowerShell: copy .env.example .env)
# ---------------------------------------------------------------------------
# Database — must match docker-compose.yml (or your own PostgreSQL server)
DATABASE_URL=postgresql://postgres:natthesisa@127.0.0.1:5432/app_db

# Optional: override the docker-compose database defaults
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=natthesisa
# POSTGRES_DB=app_db
# POSTGRES_PORT=5432

# Payments — leave PAYSTACK_SECRET_KEY empty/sk_ to run in simulated test mode
PAYSTACK_SECRET_KEY=
PAYMENT_MODE=simulation
# Public URL used in emails + Paystack callbacks. Leave empty to auto-detect
# from the incoming request (recommended: works for localhost and previews).
NEXT_PUBLIC_APP_URL=

# Admin session signing secret — use at least 32 random characters
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-32-character-secret

# Initial admin account (only used the first time the app seeds the database)
ADMIN_EMAIL=admin@meetbeatz.com
ADMIN_PASSWORD=meetbeatz123

# Email delivery (optional in development — emails are logged to the email_logs table)
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM="Meetbeatz <no-reply@meetbeatz.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
